{
  "name": "nightfall-werewolf",
  "version": "1.0.0",
  "private": true,
  "description": "夜幕之下 — 6/12 人 AI 狼人杀",
  "scripts": {
    "start": "node server.cjs",
    "test": "node scripts/run-tests.cjs",
    "test:media": "node --test video-media.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write \"*.{js,cjs,json,html,css,md}\" \"scripts/**/*.{js,cjs,json,md}\" \"test-support/**/*.cjs\"",
    "format:check": "prettier --check \"*.{js,cjs,json,html,css,md}\" \"scripts/**/*.{js,cjs,json,md}\" \"test-support/**/*.cjs\"",
    "cleanup": "node scripts/cleanup-local.cjs"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
